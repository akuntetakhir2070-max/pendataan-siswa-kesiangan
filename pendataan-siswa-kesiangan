  showToast(nama + " berhasil ditambahkan");
}

/* Riwayat */
function showRiwayat(id) {
  const s = semuaData[id];
  if (!s) return;
  document.getElementById("riwayatNama").textContent = s.nama;
  document.getElementById("riwayatKelas").textContent = s.kelas + " — Total " + s.telat + "x kesiangan";
  const list = document.getElementById("riwayatList");
  list.innerHTML = "";
  if (!s.riwayat || Object.keys(s.riwayat).length === 0) {
    list.innerHTML = `<div class="emptyMsg">Belum ada riwayat kesiangan</div>`;
  } else {
    const entries = Object.entries(s.riwayat)
      .map(([k, iso]) => ({ k, date: new Date(iso) }))
      .sort((a, b) => b.date - a.date);
    entries.forEach((e, i) => {
      list.innerHTML += `
        <div class="riwayatItem">
          <div class="riwayatNo">${entries.length - i}</div>
          <div>
            <div class="riwayatTime">${e.date.toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit",second:"2-digit"})}</div>
            <div class="riwayatDateStr">${e.date.toLocaleDateString("id-ID",{weekday:"long",day:"numeric",month:"long",year:"numeric"})}</div>
          </div>
        </div>`;
    });
  }
  showModal("riwayatModal");
}

/* ===================== EKSPOR CSV ===================== */
function exportCSV() {
  const rows = ["No,Nama,Kelas,Total Telat,Waktu Kesiangan"];
  let no = 1;
  Object.values(semuaData).forEach(s => {
    const riwStr = s.riwayat
      ? Object.values(s.riwayat).map(iso => new Date(iso).toLocaleString("id-ID")).join(" | ")
      : "";
    rows.push(`${no++},"${s.nama}","${s.kelas}",${s.telat},"${riwStr}"`);
  });
  const csv = rows.join("\n");
  const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  const d = new Date().toLocaleDateString("id-ID").replace(/\//g, "-");
  a.download = "kesiangan-" + d + ".csv";
  a.click();
  URL.revokeObjectURL(url);
  showToast("Data diekspor ke CSV");
}

/* ===================== IMPOR CSV ===================== */
function importCSV(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = async e => {
    const text = e.target.result;
    const lines = text.split("\n").map(l => l.trim()).filter(Boolean);
    if (lines.length < 2) { showToast("File CSV tidak valid", "error"); return; }
    const headers = lines[0].split(",").map(h => h.replace(/"/g,"").toLowerCase().trim());
    const namaIdx = headers.indexOf("nama");
    const kelasIdx = headers.indexOf("kelas");
    if (namaIdx === -1 || kelasIdx === -1) { showToast("CSV harus punya kolom Nama dan Kelas", "error"); return; }
    const existing = new Set(Object.values(semuaData).map(s => s.nama + "||" + s.kelas));
    let added = 0;
    for (let i = 1; i < lines.length; i++) {
      const cols = lines[i].split(",").map(c => c.replace(/"/g,"").trim());
      const nama = cols[namaIdx];
      const kelas = cols[kelasIdx];
      if (!nama || !kelas) continue;
      const key = nama + "||" + kelas;
      if (!existing.has(key)) {
        await db.ref("siswa").push({ nama, kelas, telat: 0 });
        existing.add(key);
        added++;
      }
    }
    showToast("Impor selesai: " + added + " siswa baru ditambahkan");
  };
  reader.readAsText(file);
  input.value = "";
}

/* ===================== MODAL ===================== */
function showModal(id) { document.getElementById(id).classList.remove("hidden"); }
function hideModal(id) { document.getElementById(id).classList.add("hidden"); }

// Close modal on overlay click
document.querySelectorAll(".modalOverlay").forEach(overlay => {
  overlay.addEventListener("click", e => {
    if (e.target === overlay) overlay.classList.add("hidden");
  });
});

let confirmCallback = null;
function confirmAction(msg, desc, callback) {
  document.getElementById("confirmMsg").textContent = msg;
  document.getElementById("confirmDesc").textContent = desc || "";
  confirmCallback = callback;
  document.getElementById("confirmOkBtn").onclick = () => {
    hideModal("confirmModal");
    if (confirmCallback) confirmCallback();
  };
  showModal("confirmModal");
}

/* ===================== TOAST ===================== */
function showToast(msg, type = "success") {
  const toast = document.createElement("div");
  const colors = { success: "#16a34a", error: "#dc2626", info: "#2563eb" };
  toast.style.cssText = `
    background:${colors[type]||colors.success};color:#fff;padding:12px 18px;
    border-radius:12px;font-size:13px;font-weight:600;
    box-shadow:0 4px 20px rgba(0,0,0,0.25);opacity:0;
    transition:opacity .3s,transform .3s;transform:translateY(10px);
    pointer-events:auto;max-width:300px;
  `;
  toast.textContent = msg;
  document.getElementById("toast").appendChild(toast);
  requestAnimationFrame(() => {
    toast.style.opacity = "1";
    toast.style.transform = "translateY(0)";
  });
  setTimeout(() => {
    toast.style.opacity = "0";
    toast.style.transform = "translateY(10px)";
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}
