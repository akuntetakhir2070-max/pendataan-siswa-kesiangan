/* ===================== FIREBASE DATA ===================== */
let semuaData = {};

function initData() {
  db.ref("siswa").once("value", snap => {
    if (!snap.exists()) {
      siswaDefault.forEach(item => {
        const parsed = parseKelas(item.trim());
        if (!parsed) return;
        db.ref("siswa").push({ nama: parsed.nama, kelas: parsed.kelas, telat: 0 });
      });
    }
  });
  db.ref("siswa").on("value", snap => {
    semuaData = snap.val() || {};
    renderData();
  });
}

/* ===================== RENDER ===================== */
function renderData() {
  const tbody = document.getElementById("tbody");
  const filter = document.getElementById("filterKelas").value;
  const search = document.getElementById("searchInput").value.toLowerCase();
  tbody.innerHTML = "";

  let totalSiswa = Object.keys(semuaData).length;
  let siswaTelat = 0, totalKesi = 0, no = 0;

  const entries = Object.entries(semuaData);
  const filtered = [];

  entries.forEach(([id, s]) => {
    if (s.telat > 0) siswaTelat++;
    totalKesi += (s.telat || 0);
    const matchFilter = filter === "SEMUA" || s.kelas === filter;
    const matchSearch = s.nama.toLowerCase().includes(search);
    if (matchFilter && matchSearch) filtered.push([id, s]);
  });

  document.getElementById("statTotal").textContent = totalSiswa;
  document.getElementById("statTelat").textContent = siswaTelat;
  document.getElementById("statKesi").textContent = totalKesi;
  document.getElementById("countBadge").textContent = filtered.length;

  if (filtered.length === 0) {
    tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:40px;color:#94a3b8;">Tidak ada data</td></tr>`;
    return;
  }

  filtered.forEach(([id, s]) => {
    no++;
    // Get last kesiangan time
    let lastTimeHtml = `<span style="color:#94a3b8">—</span>`;
    if (s.riwayat) {
      const times = Object.values(s.riwayat).sort();
      if (times.length > 0) {
        const lastDate = new Date(times[times.length - 1]);
        lastTimeHtml = `<div class="kesiLast">
          <div class="kesiTime">${lastDate.toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit"})}</div>
          <div class="kesiDate">${lastDate.toLocaleDateString("id-ID",{day:"numeric",month:"short",year:"numeric"})}</div>
        </div>`;
      }
    }

    const telatBadge = s.telat > 0
      ? `<span class="badge badgeRed" style="font-size:14px;padding:3px 10px;">${s.telat}x</span>`
      : `<span style="color:#94a3b8">0</span>`;

    const rowClass = s.telat > 0 ? "hasTelat" : "";
    tbody.innerHTML += `
      <tr class="${rowClass}">
        <td>${no}</td>
        <td style="font-weight:600">${escHtml(s.nama)}</td>
        <td><span class="badge badgeBlue">${escHtml(s.kelas)}</span></td>
        <td class="tdCenter">${telatBadge}</td>
        <td class="tdCenter">${lastTimeHtml}</td>
        <td class="tdCenter">
          <div class="tdActions">
            <button class="btn btnGreen btnSm" onclick="tambahTelat('${id}',${s.telat||0})">+Telat</button>
            <button class="btn btnOutline btnSm" onclick="showRiwayat('${id}')">Riwayat</button>
            <button class="btn btnOutline btnSm" onclick="confirmAction('Reset telat ${escHtml(s.nama)}?','',()=>resetTelat('${id}'))">Reset</button>
            <button class="btn btnRed btnSm" onclick="confirmAction('Hapus ${escHtml(s.nama)}?','Data akan dihapus permanen.',()=>hapusSiswa('${id}'))">Hapus</button>
          </div>
        </td>
      </tr>`;
  });
}

function escHtml(str) {
  return String(str).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

/* ===================== FITUR ===================== */
function tambahTelat(id, currentTelat) {
  const now = new Date().toISOString();
  db.ref("siswa/" + id).update({ telat: currentTelat + 1 });
  db.ref("siswa/" + id + "/riwayat").push(now);
  showToast("Kesiangan dicatat pada " + new Date().toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit",second:"2-digit"}));
}

function resetTelat(id) {
  db.ref("siswa/" + id).update({ telat: 0, riwayat: null });
  showToast("Data kesiangan direset", "info");
}

function hapusSiswa(id) {
  db.ref("siswa/" + id).remove();
  showToast("Siswa dihapus", "info");
}

function resetDatabase() {
  db.ref("siswa").remove();
  showToast("Database direset");
}

/* Tambah siswa manual */
function tambahSiswa() {
  const nama = document.getElementById("newNama").value.trim();
  const kelas = document.getElementById("newKelas").value;
  if (!nama) { showToast("Nama wajib diisi", "error"); return; }
  if (!kelas) { showToast("Kelas wajib dipilih", "error"); return; }
  db.ref("siswa").push({ nama, kelas, telat: 0 });
  document.getElementById("newNama").value = "";
  document.getElementById("newKelas").value = "";
