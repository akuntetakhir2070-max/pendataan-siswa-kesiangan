/* ===================== PARSE KELAS ===================== */
function parseKelas(teks) {
  const kelasList = ["XI TJKT 1","XI TJKT 2","XI TO","XI MP","X TO","X TJKT","X MP"];
  for (const k of kelasList) {
    if (teks.endsWith(" " + k)) {
      return { nama: teks.slice(0, teks.length - k.length - 1).trim(), kelas: k };
    }
  }
  return null;
}

